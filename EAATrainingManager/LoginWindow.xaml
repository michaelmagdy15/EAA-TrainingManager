<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="EAATrainingManager.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EAA-TMS Sign In">
    <Grid x:Name="RootGrid" MinWidth="440" MinHeight="560" FlowDirection="RightToLeft">
        <Grid.Background>
            <SolidColorBrush Color="#17324D" />
        </Grid.Background>
        <StackPanel Margin="28" VerticalAlignment="Center" Spacing="16">
            <StackPanel HorizontalAlignment="Center" Spacing="5">
                <TextBlock x:Name="AcademyTitle" Text="الأكاديمية المصرية لعلوم الطيران" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="SignInSubtitle" Text="تسجيل الدخول إلى منظومة إدارة التدريب" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="LoginPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="LoginUserName" PlaceholderText="اسم المستخدم" LostFocus="LoginUserName_LostFocus" />
                <PasswordBox x:Name="LoginPassword" PlaceholderText="كلمة المرور" />
                <ComboBox x:Name="LocationPicker" HorizontalAlignment="Stretch" />
                <Button x:Name="LoginButton" Click="LoginButton_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                    <TextBlock x:Name="LoginButtonText" Text="تسجيل الدخول" FontWeight="Bold" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="BootstrapPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="BootstrapPrompt" Text="إنشاء حساب مسؤول النظام الأول. استخدم كلمة مرور لا تقل عن 12 حرفاً." TextWrapping="Wrap" />
                <TextBox x:Name="BootstrapUserName" PlaceholderText="اسم المستخدم" />
                <TextBox x:Name="BootstrapDisplayName" PlaceholderText="الاسم الكامل" />
                <PasswordBox x:Name="BootstrapPassword" PlaceholderText="كلمة المرور (12 حرفاً على الأقل)" />
                <PasswordBox x:Name="BootstrapConfirmPassword" PlaceholderText="تأكيد كلمة المرور" />
                <Button x:Name="BootstrapButton" Click="BootstrapButton_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                    <TextBlock x:Name="BootstrapButtonText" Text="إنشاء المسؤول الأول" FontWeight="Bold" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="StatusText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="OrangeRed" />
            <Button x:Name="LanguageButton" Click="LanguageButton_Click" HorizontalAlignment="Center" Content="English" />
        </StackPanel>
    </Grid>
</Window>
