<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="EAATrainingManager.Dialogs.ArchivedOrdersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:EAATrainingManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="سلة المحفوظات والأرشيف (سجلات الأمان ضد الحذف)"
    CloseButtonText="إغلاق">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" MinWidth="600">
        <StackPanel Spacing="14" Padding="4">
            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="الحماية التلقائية من الحذف الخاطئ (Soft Delete Engine)" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="لا يتم حذف أي سجل نهائياً من قاعدة البيانات. يمكنك استعادة أي أمر تدريب بنقرة زر واحدة لإعادته فوراً للسجلات النشطة." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtArchivedCount" Text="0 سجل مؤرشف" FontWeight="Bold" FontSize="12" />

            <ListView x:Name="ArchivedListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrainingOrder">
                        <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StudentDisplayName}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="{x:Bind BiDiDisplayName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Tag="{x:Bind}" 
                                        Click="BtnRestore_Click" 
                                        Padding="10,4" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="12" Foreground="#198754" FlowDirection="LeftToRight" />
                                        <TextBlock Text="استعادة السجل ⟲" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
