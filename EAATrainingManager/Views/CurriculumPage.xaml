<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.CurriculumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Text="المناهج والخطط الدراسية" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="DescriptionText" Text="استعراض نسخ المناهج، الدروس، الأهداف التدريبية ومعايير الإنجاز المعتمدة."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <ComboBox x:Name="VersionCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Label"
                              SelectionChanged="VersionCombo_SelectionChanged"/>
                    <TextBlock x:Name="ErrorText" Foreground="#DC3545" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LessonsTitle" Text="دروس المنهج" FontWeight="SemiBold"/>
                    <ListView x:Name="LessonsList" SelectionMode="Single" SelectionChanged="LessonsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CurriculumLesson">
                                <Border Padding="12" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind LessonCode}" FontWeight="Bold"/>
                                            <Border Background="#0D6EFD" CornerRadius="10" Padding="8,2"><TextBlock Text="{x:Bind StageCode}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ArabicTitle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind EnglishTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Name="ObjectivesTitle" Text="الأهداف التدريبية" FontWeight="SemiBold"/>
                    <ListView x:Name="ObjectivesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingObjective">
                                <Border Padding="12" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}">
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ObjectiveCode}" FontWeight="Bold"/>
                                            <Border Background="#6F42C1" CornerRadius="10" Padding="8,2"><TextBlock Text="{x:Bind EvidenceType}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ArabicDescription}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind EnglishDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind PrerequisiteCodes}" Foreground="#B02A37" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{x:Bind CompletionStandard}" TextWrapping="Wrap" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>