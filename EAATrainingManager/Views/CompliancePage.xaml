<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.CompliancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4"><TextBlock x:Name="TitleText" Text="الالتزام والصلاحيات" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="DescriptionText" Text="متابعة الفحوص الطبية، مستوى اللغة الإنجليزية، الرخص والوثائق المنتهية قبل الجدولة." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}"><StackPanel Spacing="9"><TextBlock x:Name="AddTitleText" Text="إضافة سجل التزام" FontWeight="SemiBold"/><Grid ColumnSpacing="10" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="StudentCombo" PlaceholderText="المتدرب" DisplayMemberPath="DisplayName"/><ComboBox x:Name="RecordTypeCombo" Grid.Column="1" SelectedIndex="0"><ComboBoxItem x:Name="MedicalItem" Content="كشف طبي" Tag="Medical"/><ComboBoxItem x:Name="ElpItem" Content="ICAO ELP" Tag="ELP"/><ComboBoxItem x:Name="LicenceItem" Content="رخصة" Tag="License"/><ComboBoxItem x:Name="PassportItem" Content="جواز سفر" Tag="Passport"/></ComboBox><TextBox x:Name="ReferenceBox" Grid.Column="2" PlaceholderText="رقم المرجع / الشهادة"/><CheckBox x:Name="VerifiedCheckBox" Grid.Column="3" Content="تم التحقق" VerticalAlignment="Center"/><CalendarDatePicker x:Name="IssuedPicker" Grid.Row="1" PlaceholderText="تاريخ الإصدار"/><CalendarDatePicker x:Name="ExpiryPicker" Grid.Row="1" Grid.Column="1" PlaceholderText="تاريخ الانتهاء"/><TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" PlaceholderText="ملاحظات أو قيود (اختياري)"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HintText" Text="السجلات المعتمدة والمنتهية تمنع جدولة المتدرب حتى التجديد." Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8"><TextBlock x:Name="SaveText" Text="حفظ السجل" FontWeight="Bold"/></Button></Grid></StackPanel></Border>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC3545" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
        <ListView x:Name="RecordsList" Grid.Row="3" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:ComplianceRecord"><Border Padding="14" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StudentDisplayName}" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind RecordTypeText}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{x:Bind ReferenceNumber}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind ExpiryText}" VerticalAlignment="Center"/><Border Grid.Column="4" Background="{x:Bind StatusBadgeColor}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{x:Bind StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
</Page>
