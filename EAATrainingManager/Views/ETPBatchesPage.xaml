<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.ETPBatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <StackPanel Grid.Row="0" Spacing="4"><TextBlock Text="الخط جوي - ETP" FontSize="22" FontWeight="Bold"/><TextBlock Text="مسارات التشغيل وساعات الطيران الفعلية فقط" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10"><TextBox x:Name="SearchBox" PlaceholderText="ابحث بالمسار أو شركة الطيران" TextChanged="SearchBox_TextChanged"/><Border Grid.Column="1" Padding="12,7" Style="{StaticResource StatusPillBorder}"><TextBlock x:Name="CountText" FontWeight="SemiBold"/></Border></Grid>
        <ListView x:Name="RoutesList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:ETPBatch">
                <Border Padding="14" Margin="0,0,0,10" Style="{StaticResource FluentCardBorder}">
                    <Grid ColumnSpacing="18">
                        <StackPanel><TextBlock Text="{x:Bind BiDiDisplayName}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{x:Bind StatusText}" Foreground="{x:Bind StatusBadgeColor}"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedStartDate}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedEndDate}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind FlightHoursText}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind TotalPilotsText}"/>
                    </Grid>
                </Border>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
