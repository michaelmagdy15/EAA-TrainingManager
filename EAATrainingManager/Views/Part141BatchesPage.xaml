<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.Part141BatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="الدفعات المعتمدة - Part 141" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="بيانات البرنامج، التقدم، المرفقات وكشف الطلبة لكل دفعة" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right" Click="Refresh_Click" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="تحديث"/></StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <TextBox x:Name="SearchBox" PlaceholderText="ابحث بالدفعة أو البرنامج أو اسم الطالب" TextChanged="SearchBox_TextChanged"/>
            <Border Grid.Column="1" Padding="12,7" Style="{StaticResource StatusPillBorder}"><TextBlock x:Name="CountText" Text="0 دفعة" FontWeight="SemiBold"/></Border>
        </Grid>
        <ListView x:Name="BatchesList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Part141Batch">
                    <Border Padding="14" Margin="0,0,0,10" Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind BiDiDisplayName}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{x:Bind StatusText}" Foreground="{x:Bind StatusBadgeColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Border Padding="9,5" Background="#6F42C1" CornerRadius="12"><TextBlock Text="{x:Bind TotalStudents}" Foreground="White" FontWeight="Bold"/></Border>
                                    <Border Padding="9,5" Background="#198754" CornerRadius="12"><TextBlock Text="{x:Bind GraduatedStudents}" Foreground="White" FontWeight="Bold"/></Border>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <TextBlock Text="{x:Bind FormattedStartDate}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedEndDate}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind SyllabusHoursText}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind AttachmentsBadgeText}" Foreground="#0D6EFD"/>
                            </Grid>
                            <TextBlock Text="{x:Bind NationalitiesSummary}" Foreground="#FD7E14" TextWrapping="Wrap"/>
                            <Expander Header="كشف الطلبة والتفاصيل">
                                <StackPanel Spacing="6" Padding="0,8,0,0">
                                    <TextBlock Text="{x:Bind ProgressSummaryText}" FontWeight="SemiBold"/>
                                    <ListView ItemsSource="{x:Bind StudentRoster}" SelectionMode="None" MaxHeight="180">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:Student">
                                            <Grid ColumnSpacing="12" Padding="4">
                                                <TextBlock Text="{x:Bind DisplayName}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Nationality}"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind NationalityBadgeText}" Foreground="{x:Bind NationalityBadgeColor}"/>
                                            </Grid>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
