<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EAATrainingManager.Views.StudentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EAATrainingManager.Views"
    xmlns:models="using:EAATrainingManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TxtPageTitle" Text="سجل الطلبة والمتدربين الموحد" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0,4,0,6" />
                <TextBlock x:Name="TxtPageDesc" Text="الملف التعريفي الشامل لكل متدرب كشخص مستقل مع تتبع مسارات الطيران التاريخية وتفكيك تكرار الأوامر" 
                           FontSize="13" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="BtnAddOrder" Grid.Column="1" Click="BtnAddOrder_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="14,8,14,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Name="TxtBtnAddOrder" Text="أمر تدريب جديد" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search and Filter Controls -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorder}" Margin="0,0,0,16" Padding="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox" 
                         PlaceholderText="ابحث باسم المتدرب (بحث ذكي بالهمزات، الـ التعريف، وعائلة الاسم)..." 
                         CornerRadius="8"
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center">
                </TextBox>

                <!-- Status Filter Combobox -->
                <ComboBox x:Name="StatusFilterCombo" 
                          Grid.Column="1" 
                          CornerRadius="8" 
                          SelectionChanged="StatusFilterCombo_SelectionChanged"
                          VerticalAlignment="Center"
                          MinWidth="140">
                    <ComboBoxItem x:Name="ComboItemAll" Content="الجميع" IsSelected="True" />
                    <ComboBoxItem x:Name="ComboItemActive" Content="قيد التدريب" />
                    <ComboBoxItem x:Name="ComboItemGraduated" Content="خريج" />
                </ComboBox>

                <!-- Counter Badge -->
                <Border Grid.Column="2" Style="{StaticResource StatusPillBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStudentsCount" Text="0 طالب" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area: Master List + Trajectory Side Panel -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColTrajectory" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Students List Table -->
            <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}" Padding="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled" 
                              HorizontalScrollMode="Enabled" 
                              VerticalScrollMode="Disabled">
                    <Grid MinWidth="850">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="16,10,16,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ColCode" Grid.Column="0" Text="كود" FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="ColName" Grid.Column="1" Text="اسم المتدرب" FontWeight="Bold" />
                                <TextBlock x:Name="ColNat" Grid.Column="2" Text="الجنسية" FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="ColOrders" Grid.Column="3" Text="الأوامر" FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="ColStatus" Grid.Column="4" Text="الحالة" FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="ColMilestones" Grid.Column="5" Text="المراحل المجتازة" FontWeight="Bold" />
                                <TextBlock x:Name="ColTrajectoryHeader" Grid.Column="6" Text="المسار 360°" FontWeight="Bold" TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Students ListView -->
                        <ListView x:Name="StudentsListView" 
                                  Grid.Row="1" 
                                  SelectionMode="Single"
                                  SelectionChanged="StudentsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Student">
                                    <Border Padding="8,8,8,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind Id}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,2,0,4" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Nationality}" TextAlignment="Center" VerticalAlignment="Center" />
                                            
                                            <!-- Orders count pill -->
                                            <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPillBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind TotalOrdersCount}" FontSize="12" FontWeight="Bold" />
                                            </Border>

                                            <!-- Overall Status Pill -->
                                            <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPillBorder}" Background="{x:Bind StatusBadgeColor}">
                                                <TextBlock Text="{x:Bind OverallStatus}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>

                                            <!-- Milestones Summary -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind MilestonesSummary}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <!-- Inspect Trajectory Button -->
                                            <Button Grid.Column="6" 
                                                    Content="عرض المسار" 
                                                    Click="BtnViewTrajectory_Click" 
                                                    Tag="{x:Bind}" 
                                                    HorizontalAlignment="Center" 
                                                    Padding="10,4,10,4" 
                                                    FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Trajectory Side Panel (Detailed 360° View) -->
            <Border x:Name="TrajectoryPanel" Grid.Column="1" Width="380" Style="{StaticResource FluentCardBorder}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Panel Header -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TxtTrajectoryPanelTitle" Text="المسار الزمني للمتدرب 360°" FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="TxtTrajectoryPanelDesc" Text="التسلسل التاريخي لجميع أوامر الطيران والكورسات" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Click="BtnCloseTrajectory_Click" Padding="6">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Trainee Identity Card -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TxtTrajectoryStudentName" Text="اسم المتدرب" FontSize="16" FontWeight="Bold" Padding="0,2,0,4" />
                                <Grid>
                                    <TextBlock x:Name="TxtTrajectoryNationality" Text="الجنسية: مصري" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border x:Name="TrajectoryStatusPill" HorizontalAlignment="Left" Style="{StaticResource StatusPillBorder}" Background="#0D6EFD">
                                        <TextBlock x:Name="TxtTrajectoryStatus" Text="قيد التدريب" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pathway Progression Checklist -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="TxtCurriculumHeader" Text="محطات مسار الطيران (Curriculum Pipeline):" FontSize="12" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="PillPPL" Style="{StaticResource StatusPillBorder}" Background="#E9ECEF">
                                        <TextBlock x:Name="TxtPillPPL" Text="PPL طيار خاص" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="➔" VerticalAlignment="Center" Opacity="0.5" />
                                    <Border x:Name="PillCPLIR" Style="{StaticResource StatusPillBorder}" Background="#E9ECEF">
                                        <TextBlock x:Name="TxtPillCPLIR" Text="CPL/IR تجاري وعدادات" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="➔" VerticalAlignment="Center" Opacity="0.5" />
                                    <Border x:Name="PillATP" Style="{StaticResource StatusPillBorder}" Background="#E9ECEF">
                                        <TextBlock x:Name="TxtPillATP" Text="ATP خط جوي" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Timeline of Enrolled Orders -->
                        <TextBlock x:Name="TxtEnrolledOrdersHeader" Text="أوامر التدريب المسجلة لهذا المتدرب:" FontSize="13" FontWeight="Bold" />

                        <ItemsControl x:Name="TrajectoryOrdersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TrainingOrder">
                                    <Border Margin="0,0,0,10" Style="{StaticResource FluentCardBorder}" Padding="12" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="أمر تدريب رقم:" FontWeight="Bold" FontSize="12" />
                                                    <TextBlock Text="{x:Bind OrderNumber}" FontWeight="Bold" FontSize="12" Foreground="#0D6EFD" />
                                                    <TextBlock Text="لسنة" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Year}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Border HorizontalAlignment="Left" Style="{StaticResource StatusPillBorder}" Background="{x:Bind StatusBadgeColor}">
                                                    <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{x:Bind BiDiProgramType}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind RegulationCategory}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <Grid Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="الالتحاق:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedEnrollmentDate}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="4">
                                                    <TextBlock Text="النهاية:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedCompletionDate}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Notes if any -->
                                            <TextBlock Text="{x:Bind BiDiNotes}" FontSize="11" Foreground="#6C757D" FontStyle="Italic" Margin="0,2,0,0" />

                                            <!-- Complete Course Action -->
                                            <Button Content="إتمام الكورس ✓" 
                                                    FontSize="11" 
                                                    Padding="8,4" 
                                                    CornerRadius="6" 
                                                    Background="#D1E7DD" 
                                                    Foreground="#0F5132" 
                                                    Click="BtnCompleteOrder_Click" 
                                                    Margin="0,6,0,0" 
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
