<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Text="بوابة تقدم المتدرب" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="DescriptionText" Text="المتطلبات المتبقية، العوائق، الفحوصات المرحلية، الخطط العلاجية ومطابقة الساعات."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="StudentCombo" HorizontalAlignment="Stretch" SelectionChanged="StudentCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Student">
                            <StackPanel>
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind Nationality}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="OrderCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OrderCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TrainingOrder">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="{x:Bind OrderNumber}"/><Run Text=" — "/><Run Text="{x:Bind ProgramType}"/></TextBlock>
                                <TextBlock Text="{x:Bind Milestone}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="14" Style="{StaticResource FluentCardBorder}">
                <StackPanel>
                    <Grid ColumnSpacing="20" RowSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="HoursRequiredLabel" Text="الساعات المطلوبة" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursRequiredValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="HoursScheduledLabel" Text="ساعات الجلسات المجدولة" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursScheduledValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock x:Name="HoursCompletedLabel" Text="ساعات الجلسات المكتملة" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursCompletedValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock x:Name="HoursFlightLabel" Text="ساعات سجلات الطيران" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursFlightValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="HoursHobbsLabel" Text="فروق الهوبس" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursHobbsValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                        <TextBlock x:Name="HoursRemainingLabel" Text="الساعات المتبقية" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="HoursRemainingValue" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Left" CornerRadius="12" Padding="12,4">
                        <TextBlock x:Name="ReconcileText" Text="" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    </Border>
                    </Grid>
                    <Border Margin="0,10,0,0" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Visibility="Collapsed">
                    <ListView x:Name="IssuesList" SelectionMode="None" MaxHeight="130">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingHourIssue">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="2,3">
                                    <Border Background="#DC3545" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Code}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border>
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="RequirementsTitle" Text="المتطلبات المتبقية" FontWeight="SemiBold"/>
                    <ListView x:Name="RequirementsList" SelectionMode="None" MaxHeight="460">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RemainingRequirement">
                                <Border Padding="12" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind LessonCode}" FontWeight="Bold"/>
                                            <Border Background="#0D6EFD" CornerRadius="10" Padding="8,2"><TextBlock Text="{x:Bind ObjectiveCode}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ArabicDescription}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind BlockersText}" Foreground="#B02A37" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Name="StageChecksTitle" Text="الفحوصات المرحلية" FontWeight="SemiBold"/>
                    <ListView x:Name="StageChecksList" SelectionMode="None" MaxHeight="460">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StageCheck">
                                <Border Padding="12" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind StageCode}" FontWeight="Bold"/>
                                            <TextBlock Text="{x:Bind Result}" FontWeight="Bold"/>
                                            <TextBlock Text="{x:Bind AssessedAt}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ExaminerName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind Deficiencies}" TextWrapping="Wrap" Foreground="#B02A37"/>
                                        <TextBlock Text="{x:Bind RemedialReference}" TextWrapping="Wrap" Foreground="#0D6EFD" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock x:Name="RemedialsTitle" Text="الخطط العلاجية" FontWeight="SemiBold"/>
                    <ListView x:Name="RemedialsList" SelectionMode="None" MaxHeight="460">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RemedialPlan">
                                <Border Padding="12" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ObjectiveCode}" FontWeight="Bold"/>
                                            <Border Background="#6F42C1" CornerRadius="10" Padding="8,2"><TextBlock Text="{x:Bind Status}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                            <TextBlock Text="{x:Bind DueDateText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ArabicPlan}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind EnglishPlan}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind CompletionRemarks}" TextWrapping="Wrap" Foreground="#198754"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8" IsEnabled="False">
                <TextBlock x:Name="ExportText" Text="تصدير السجل الرسمي (Excel)" FontWeight="Bold"/>
            </Button>
            <Button x:Name="AcknowledgeButton" Grid.Column="1" Click="Acknowledge_Click" Padding="16,8" IsEnabled="False">
                <TextBlock x:Name="AcknowledgeText" Text="توقيع المتدرب" FontWeight="Bold"/>
            </Button>
            <TextBlock x:Name="ErrorText" Grid.Column="2" Foreground="#DC3545" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock x:Name="SuccessText" Grid.Column="3" Foreground="#198754" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>