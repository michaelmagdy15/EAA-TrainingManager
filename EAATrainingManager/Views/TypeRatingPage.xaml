<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EAATrainingManager.Views.TypeRatingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EAATrainingManager.Views"
    xmlns:models="using:EAATrainingManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TxtHeaderTitle" 
                           Text="تجديد طراز وبناء ساعات طيران (Type Rating &amp; Hour Building)" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                           Padding="0,4,0,6" />
                <TextBlock x:Name="TxtHeaderDesc" 
                           Text="المسار التشغيلي الخاص بالطيارين التجاريين لتجديد وفروق الطراز وباقات بناء الساعات للطلبة والوافدين على أسطول الأكاديمية" 
                           FontSize="13" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Executive Metrics Grid -->
        <Grid Grid.Row="1" ColumnSpacing="14" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Pilots -->
            <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}" BorderBrush="#0DCAF0" BorderThickness="1.5">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TxtCard1Title" Text="إجمالي الطيارين المسجلين" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtTotalPilots" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0DCAF0" />
                    <TextBlock x:Name="TxtCard1Desc" Text="طيار ومتدرب على أسطول الأكاديمية" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Type Rating -->
            <Border Grid.Column="1" Style="{StaticResource FluentCardBorder}" BorderBrush="#0D6EFD" BorderThickness="1.5">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TxtCard2Title" Text="تجديد وفروق الطراز" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtTypeRatingCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0D6EFD" />
                    <TextBlock x:Name="TxtCard2Desc" Text="أوامر تجديد صلاحية وفروق طراز" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Hour Building -->
            <Border Grid.Column="2" Style="{StaticResource FluentCardBorder}" BorderBrush="#FD7E14" BorderThickness="1.5">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TxtCard3Title" Text="بناء ساعات طيران" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtHourBuildingCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FD7E14" />
                    <TextBlock x:Name="TxtCard3Desc" Text="باقات ساعات للطلبة والوافدين" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Active in Cockpit -->
            <Border Grid.Column="3" Style="{StaticResource FluentCardBorder}" BorderBrush="#198754" BorderThickness="1.5">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TxtCard4Title" Text="قيد التنفيذ العملي" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtActiveCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#198754" />
                    <TextBlock x:Name="TxtCard4Desc" Text="رحلات طيران ومحاكي جارية" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter Ribbon -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardBorder}" Margin="0,0,0,16" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollMode="Enabled">
                <Grid ColumnSpacing="12" MinWidth="780">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox x:Name="SearchBox" 
                             Grid.Column="0" 
                             PlaceholderText="بحث باسم الطيار، رقم أمر التدريب، أو ملاحظات الطائرة..." 
                             TextChanged="SearchBox_TextChanged" />

                    <!-- Activity Type Filter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActivityLabel" Text="نوع النشاط:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="ActivityTypeCombo" 
                                  SelectedIndex="0" 
                                  SelectionChanged="FilterChanged" 
                                  Width="140">
                            <ComboBoxItem x:Name="ComboItemActivityAll" Content="الكل" />
                            <ComboBoxItem x:Name="ComboItemActivityRating" Content="تجديد طراز" />
                            <ComboBoxItem x:Name="ComboItemActivityHours" Content="بناء ساعات" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Fleet Aircraft Presets -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAircraftLabel" Text="طراز الطائرة:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="AircraftFleetCombo" 
                                  SelectedIndex="0" 
                                  SelectionChanged="FilterChanged" 
                                  Width="180">
                            <ComboBoxItem x:Name="ComboItemAircraftAll" Content="كافة الطرازات" Tag="All" />
                            <ComboBoxItem Content="Cessna 172" Tag="C172" />
                            <ComboBoxItem Content="Cessna 172 Gas" Tag="C172 Gas" />
                            <ComboBoxItem Content="Baron B58" Tag="B58" />
                            <ComboBoxItem Content="Bonanza G36" Tag="G36" />
                            <ComboBoxItem Content="Cessna Centurion" Tag="Cessna Centurion" />
                            <ComboBoxItem Content="Beechcraft BE-76 Duchess" Tag="BE-76" />
                            <ComboBoxItem Content="Piper PA-28/34" Tag="PA-28/34" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Grid.Column="3" Click="BtnRefresh_Click" ToolTipService.ToolTip="تحديث البيانات">
                        <FontIcon Glyph="&#xE72C;" FlowDirection="LeftToRight" FontSize="14" />
                    </Button>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Interactive Data Grid (Horizontally Scrollable) -->
        <Border Grid.Row="3" Style="{StaticResource FluentCardBorder}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="960">
                    <!-- Table Header -->
                    <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="16,12,16,12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Col0" Grid.Column="0" Text="م" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col1" Grid.Column="1" Text="اسم الطيار / المتدرب" FontWeight="Bold" />
                            <TextBlock x:Name="Col2" Grid.Column="2" Text="الجنسية" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col3" Grid.Column="3" Text="رقم الأمر" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col4" Grid.Column="4" Text="البرنامج التدريبي" FontWeight="Bold" />
                            <TextBlock x:Name="Col5" Grid.Column="5" Text="تاريخ البدء" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col6" Grid.Column="6" Text="تاريخ النهاية" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col7" Grid.Column="7" Text="الحالة" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col8" Grid.Column="8" Text="الإجراء" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="Col9" Grid.Column="9" Text="ملاحظات وساعات الطيران" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ListView x:Name="OrdersListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingOrder">
                                <Border Padding="12,10,12,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind StudentDisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,2,0,4" />
                                        
                                        <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPillBorder}" Background="{ThemeResource LayerFillColorAltBrush}">
                                            <TextBlock Text="{x:Bind Nationality}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{x:Bind OrderNumber}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind BiDiProgramType}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedEnrollmentDate}" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedCompletionDate}" TextAlignment="Center" VerticalAlignment="Center" />

                                        <Border Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPillBorder}" Background="{x:Bind StatusBadgeColor}">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <Button Grid.Column="8" 
                                                Tag="{x:Bind}" 
                                                Click="BtnToggleStatus_Click" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"
                                                Padding="8,4,8,4">
                                            <TextBlock Text="{x:Bind ToggleButtonText}" FontSize="11" />
                                        </Button>

                                        <TextBlock Grid.Column="9" Text="{x:Bind BiDiNotes}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
