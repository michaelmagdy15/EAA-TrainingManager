<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.ResourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4"><TextBlock x:Name="ResourcesTitle" Text="الأسطول والمحاكيات" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="ResourcesDescription" Text="إدارة جاهزية الطائرات وأجهزة المحاكاة، ساعات العدادات وحدود الصيانة." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}">
            <StackPanel Spacing="9">
                <TextBlock x:Name="SaveResourceTitle" Text="إضافة أو تحديث مورد" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="10" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RegistrationBox" PlaceholderText="رقم التسجيل / رمز المحاكي"/>
                    <TextBox x:Name="AircraftTypeBox" Grid.Column="1" PlaceholderText="الطراز (مثال C172)"/>
                    <TextBox x:Name="BaseBox" Grid.Column="2" PlaceholderText="القاعدة / المطار"/>
                    <ComboBox x:Name="ResourceTypeCombo" Grid.Column="3" SelectedIndex="0"><ComboBoxItem x:Name="AircraftTypeItem" Content="طائرة" Tag="Aircraft"/><ComboBoxItem x:Name="SimulatorTypeItem" Content="جهاز محاكاة" Tag="Simulator"/></ComboBox>
                    <NumberBox x:Name="HobbsBox" Grid.Row="1" PlaceholderText="ساعات عداد هوبس" Minimum="0" SpinButtonPlacementMode="Inline"/>
                    <NumberBox x:Name="TachBox" Grid.Row="1" Grid.Column="1" PlaceholderText="ساعات عداد تاك" Minimum="0" SpinButtonPlacementMode="Inline"/>
                    <NumberBox x:Name="MaintenanceDueBox" Grid.Row="1" Grid.Column="2" PlaceholderText="حد الصيانة بالساعات" Minimum="0" SpinButtonPlacementMode="Inline"/>
                    <ComboBox x:Name="StatusCombo" Grid.Row="1" Grid.Column="3" SelectedIndex="0"><ComboBoxItem Content="متاحة" Tag="Available"/><ComboBoxItem Content="تحت الصيانة" Tag="Maintenance"/><ComboBoxItem Content="غير صالحة للتشغيل" Tag="Unserviceable"/></ComboBox>
                </Grid>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NotesBox" PlaceholderText="ملاحظات / عطل مفتوح (اختياري)"/><Button Grid.Column="1" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8"><TextBlock x:Name="SaveResourceButtonText" Text="حفظ المورد" FontWeight="Bold"/></Button></Grid>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC3545" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
        <ListView x:Name="ResourcesList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:AircraftResource"><Border Padding="14" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind BiDiDisplayName}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{x:Bind ResourceTypeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Base}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind HoursText}"/><TextBlock Text="{x:Bind MaintenanceText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="{x:Bind Notes}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Grid.Column="4" Background="{x:Bind StatusBadgeColor}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{x:Bind StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
