<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="ScheduleTitle" Text="التخطيط والتشغيل اليومي" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="ScheduleDescription" Text="جدولة الدروس والرحلات مع منع تعارض المتدرب أو المدرب أو الطائرة / جهاز المحاكاة." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <CalendarDatePicker x:Name="PickerDate" DateChanged="PickerDate_DateChanged" />
                <Button Click="Refresh_Click" Padding="12,7"><FontIcon Glyph="&#xE72C;" /></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="AddSessionTitle" Text="إضافة جلسة تدريب" FontWeight="SemiBold" />
                <Grid ColumnSpacing="10" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="StudentCombo" PlaceholderText="المتدرب" DisplayMemberPath="DisplayName" />
                    <TextBox x:Name="LessonBox" Grid.Column="1" PlaceholderText="الدرس / النشاط" />
                    <TextBox x:Name="InstructorBox" Grid.Column="2" PlaceholderText="المدرب" />
                    <TextBox x:Name="ResourceBox" Grid.Column="3" PlaceholderText="الطائرة أو المحاكي" />
                    <ComboBox x:Name="TrackCombo" Grid.Row="1" SelectedIndex="0">
                        <ComboBoxItem x:Name="TrackPart61" Content="النظام الحر 61" Tag="Part61" />
                        <ComboBoxItem x:Name="TrackPart141" Content="النظام المعتمد 141" Tag="Part141" />
                        <ComboBoxItem x:Name="TrackETP" Content="الخط الجوي ETP" Tag="ETP" />
                        <ComboBoxItem x:Name="TrackTypeRating" Content="تأهيل طراز" Tag="TypeRating" />
                    </ComboBox>
                    <TimePicker x:Name="StartTimePicker" Grid.Row="1" Grid.Column="1" ClockIdentifier="24HourClock" />
                    <TimePicker x:Name="EndTimePicker" Grid.Row="1" Grid.Column="2" ClockIdentifier="24HourClock" />
                    <TextBox x:Name="LocationBox" Grid.Row="1" Grid.Column="3" PlaceholderText="الموقع / القاعة" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NotesBox" PlaceholderText="ملاحظات التشغيل (اختياري)" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Click="AddSession_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;"/><TextBlock x:Name="AddSessionButtonText" Text="إضافة للجدول" FontWeight="Bold"/></StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC3545" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />

        <Border Grid.Row="3" Style="{StaticResource FluentCardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Background="{ThemeResource LayerFillColorAltBrush}" Padding="14,10">
                    <TextBlock x:Name="ScheduleCountText" Text="0 جلسة" FontWeight="Bold" />
                </Grid>
                <ListView x:Name="SessionsList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrainingSession">
                            <Border Padding="14,9" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TimeRangeText}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind StudentBiDiName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind RegulatoryTrackText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind LessonBiDiName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind InstructorName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ResourceName}" VerticalAlignment="Center" />
                                    <Border Grid.Column="5" Background="{x:Bind StatusBadgeColor}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{x:Bind StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                        <Button Tag="{x:Bind}" Click="Dispatch_Click" Padding="7,4" ToolTipService.ToolTip="Dispatch"><FontIcon Glyph="&#xE768;" FontSize="12"/></Button>
                                        <Button Tag="{x:Bind}" Click="Complete_Click" Padding="7,4" ToolTipService.ToolTip="Complete"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#198754"/></Button>
                                        <Button Tag="{x:Bind}" Click="Cancel_Click" Padding="7,4" ToolTipService.ToolTip="Cancel"><FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#DC3545"/></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
