<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EAATrainingManager.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EAATrainingManager.Views"
    xmlns:models="using:EAATrainingManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TxtPageTitle" Text="سجل أوامر التدريب والكورسات" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0,4,0,6" />
                <TextBlock x:Name="TxtPageDesc" 
                           Text="متابعة أوامر التدريب وحالات الطيران النشطة مع التبديل الفوري لحالة الإتمام (تحديث تاريخ النهاية يغلق الأمر ويحدث ملف المتدرب)" 
                           FontSize="13" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnAddOrderPage"
                        Click="BtnAddOrderPage_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" FlowDirection="LeftToRight" />
                        <TextBlock x:Name="TxtBtnAddOrder" Text="أمر تدريب جديد" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnArchivePage"
                        Click="BtnArchivePage_Click"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#6C757D" FlowDirection="LeftToRight" />
                        <TextBlock x:Name="TxtBtnArchive" Text="سلة الأرشيف" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Ribbon -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorder}" Margin="0,0,0,16" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollMode="Enabled">
                <Grid ColumnSpacing="12" MinWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox x:Name="SearchBox" 
                             PlaceholderText="ابحث برقم الأمر، اسم المتدرب، أو الملاحظات..." 
                             CornerRadius="8"
                             TextChanged="SearchBox_TextChanged"
                             VerticalAlignment="Center" />

                    <!-- Status Filter -->
                    <ComboBox x:Name="StatusFilterCombo" 
                              Grid.Column="1" 
                              CornerRadius="8" 
                              SelectionChanged="FilterChanged" 
                              MinWidth="130" 
                              VerticalAlignment="Center">
                        <ComboBoxItem x:Name="ComboItemStatusAll" Content="الجميع" IsSelected="True" />
                        <ComboBoxItem x:Name="ComboItemStatusActive" Content="قيد التدريب" />
                        <ComboBoxItem x:Name="ComboItemStatusFinished" Content="منتهي" />
                    </ComboBox>

                    <!-- Milestone Filter -->
                    <ComboBox x:Name="MilestoneFilterCombo" 
                              Grid.Column="2" 
                              CornerRadius="8" 
                              SelectionChanged="FilterChanged" 
                              MinWidth="150" 
                              VerticalAlignment="Center">
                        <ComboBoxItem x:Name="ComboItemMilestoneAll" Content="كافة المناهج" IsSelected="True" />
                        <ComboBoxItem Content="PPL" />
                        <ComboBoxItem Content="CPL_IR" />
                        <ComboBoxItem Content="ATP" />
                        <ComboBoxItem Content="EVALUATION" />
                        <ComboBoxItem Content="TYPE_RATING" />
                    </ComboBox>

                    <!-- Year Filter -->
                    <ComboBox x:Name="YearFilterCombo" 
                              Grid.Column="3" 
                              CornerRadius="8" 
                              SelectionChanged="FilterChanged" 
                              MinWidth="110" 
                              VerticalAlignment="Center">
                        <ComboBoxItem x:Name="ComboItemYearAll" Content="كل السنوات" IsSelected="True" />
                        <ComboBoxItem Content="2026" />
                        <ComboBoxItem Content="2025" />
                    </ComboBox>

                    <!-- Badge Count -->
                    <Border Grid.Column="4" Style="{StaticResource StatusPillBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOrdersCount" Text="0 أمر" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Orders Table -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardBorder}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollMode="Enabled" 
                          VerticalScrollMode="Disabled">
                <Grid MinWidth="1020">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="16,10,16,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ColSeq" Grid.Column="0" Text="م" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColOrderNum" Grid.Column="1" Text="رقم الأمر" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColStudentName" Grid.Column="2" Text="اسم المتدرب / الطالب" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColNationality" Grid.Column="3" Text="الجنسية" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColProgram" Grid.Column="4" Text="البرنامج / المنهج" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColEnrollDate" Grid.Column="5" Text="الالتحاق" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColEndDate" Grid.Column="6" Text="النهاية" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColStatus" Grid.Column="7" Text="الحالة" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColAction" Grid.Column="8" Text="الإجراءات" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColNotes" Grid.Column="9" Text="ملاحظات" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Orders ListView -->
                    <ListView x:Name="OrdersListView" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="48" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingOrder">
                                <Border Padding="16,6,16,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind SequenceNumber}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind OrderNumber}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0D6EFD" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StudentDisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,2,0,4" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Nationality}" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind BiDiProgramType}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedEnrollmentDate}" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedCompletionDate}" TextAlignment="Center" VerticalAlignment="Center" />
                                        
                                        <!-- Status Pill -->
                                        <Border Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPillBorder}" Background="{x:Bind StatusBadgeColor}">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <!-- Multi-Action Bar -->
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Tag="{x:Bind}" 
                                                    Click="BtnCompleteOrder_Click" 
                                                    Padding="7,5" 
                                                    CornerRadius="6"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="توثيق إتمام الكورس">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" FlowDirection="LeftToRight" />
                                            </Button>
                                            <Button Tag="{x:Bind}" 
                                                    Click="BtnToggleStatus_Click" 
                                                    Padding="8,5" 
                                                    CornerRadius="6"
                                                    FontSize="11">
                                                <TextBlock Text="{x:Bind ToggleButtonText}" />
                                            </Button>
                                            <Button Tag="{x:Bind}" 
                                                    Click="BtnArchiveOrder_Click" 
                                                    Padding="7,5" 
                                                    CornerRadius="6"
                                                    ToolTipService.ToolTip="أرشفة السجل إلى سلة الأمان">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#DC3545" FlowDirection="LeftToRight" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Notes -->
                                        <TextBlock Grid.Column="9" Text="{x:Bind BiDiNotes}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
