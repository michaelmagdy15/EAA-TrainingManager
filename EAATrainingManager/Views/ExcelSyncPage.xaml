<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EAATrainingManager.Views.ExcelSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EAATrainingManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardImport.(Grid.Row)" Value="0" />
                        <Setter Target="CardImport.(Grid.Column)" Value="0" />
                        <Setter Target="CardExport.(Grid.Row)" Value="0" />
                        <Setter Target="CardExport.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardImport.(Grid.Row)" Value="0" />
                        <Setter Target="CardImport.(Grid.Column)" Value="0" />
                        <Setter Target="CardExport.(Grid.Row)" Value="1" />
                        <Setter Target="CardExport.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
            <StackPanel Spacing="18">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtPageTitle" Text="مزامنة واستيراد ملفات الإكسيل (ClosedXML)" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0,4,0,6" />
                    <TextBlock x:Name="TxtPageDesc" 
                               Text="محرك معالجة محلي 100% يعمل بدون إنترنت - تفكيك سجلات أوامر التدريب وإعادة تصدير التقارير الوزارية المعتمدة" 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Grid with Import Card & Export Card (Adaptive Stacking) -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ingest / Import Card -->
                    <Border x:Name="CardImport" Grid.Row="0" Grid.Column="0" Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" Foreground="#0D6EFD" FlowDirection="LeftToRight" />
                                <TextBlock x:Name="TxtImportCardTitle" Text="استيراد وتفكيك سجلات التدريب" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock x:Name="TxtSourcePathLabel" Text="مسار ملف الإكسيل المصدر:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            
                            <TextBox x:Name="TxtFilePath" 
                                     Text="C:\Users\Mi5a\EAA System\2اوامر التدريب.xlsx" 
                                     CornerRadius="8" 
                                     FlowDirection="LeftToRight" 
                                     TextAlignment="Left" />

                            <TextBlock x:Name="TxtImportNotes" 
                                       Text="* يتم تلقائياً قراءة أوراق العمل (تقييم د، نظام حر 61، نظام 141، خط جوي، تجديد طراز) وتوحيد أسماء المتدربين وفصل الرؤوس عن الأوامر." 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" />

                            <ProgressBar x:Name="ImportProgressBar" IsIndeterminate="False" Height="6" Visibility="Collapsed" />

                            <TextBlock x:Name="TxtImportStatus" Text="جاهز للمزامنة" FontSize="12" FontWeight="SemiBold" Foreground="#0D6EFD" />

                            <Button x:Name="BtnStartImport" 
                                    Click="BtnStartImport_Click" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Padding="16,8,16,8" 
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" FlowDirection="LeftToRight" />
                                    <TextBlock x:Name="TxtStartImportBtn" Text="بدء استيراد ومعالجة البيانات" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Export Official Ministry Report Card -->
                    <Border x:Name="CardExport" Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" Foreground="#198754" FlowDirection="LeftToRight" />
                                <TextBlock x:Name="TxtExportCardTitle" Text="تصدير التقرير الوزاري الرسمي (RTL)" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock x:Name="TxtExportDescLabel" Text="توليد مصنف إكسيل مطابق للمعايير الرسمية لوزارة الطيران المدني:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Spacing="6" Margin="0,2,0,2">
                                <TextBlock x:Name="TxtExportBullet1" Text="✔ تفعيل اتجاه الورقة من اليمين لليسار (RightToLeft = true)" FontSize="11" />
                                <TextBlock x:Name="TxtExportBullet2" Text="✔ ترويسة وزارية رسمية بـ 4 أسطر مع تنسيق الألوان الملكية" FontSize="11" />
                                <TextBlock x:Name="TxtExportBullet3" Text="✔ تنسيق أرقام عربية قياسية (Western Arabic 1, 2, 3) لمنع الارتباك" FontSize="11" />
                                <TextBlock x:Name="TxtExportBullet4" Text="✔ تمييز حالات التدريب النشطة والمنتهية بألوان معيارية" FontSize="11" />
                            </StackPanel>

                            <TextBlock x:Name="TxtExportStatus" Text="سيتم حفظ الملف مباشرة على سطح المكتب" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <Button x:Name="BtnExportReport" 
                                    Click="BtnExportReport_Click" 
                                    Padding="16,8,16,8" 
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FlowDirection="LeftToRight" />
                                    <TextBlock x:Name="TxtExportReportBtn" Text="تصدير السجل الوزاري لسطح المكتب" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            <!-- Sync & Audit Activity Log Console -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="TxtAuditLogTitle" Text="سجل عمليات المزامنة والتدقيق (Sync Audit Log)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="BtnClearLogs" HorizontalAlignment="Left" Content="مسح السجل" Click="BtnClearLogs_Click" Padding="10,4,10,4" FontSize="11" />
                    </Grid>

                    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="12" MinHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                            <ItemsControl x:Name="LogsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="0,2,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
