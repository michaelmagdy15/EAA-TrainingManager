<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.FlightRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:EAATrainingManager.Models">
    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock x:Name="TitleText" Text="سجل الطيران والدروس" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="DescriptionText" Text="توثيق الطلعات الجوية والمحاكيات والدروس المكتملة مع الزمن والهبوط وساعات الطائرة." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}"><StackPanel Spacing="10"><TextBlock x:Name="AddTitleText" Text="إضافة سجل تشغيل مكتمل" FontWeight="SemiBold"/><Grid ColumnSpacing="10" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="StudentCombo" PlaceholderText="المتدرب" DisplayMemberPath="DisplayName"/><ComboBox x:Name="ActivityTypeCombo" Grid.Column="1" SelectedIndex="0"><ComboBoxItem x:Name="DualItem" Content="طيران مزدوج" Tag="Dual"/><ComboBoxItem x:Name="SoloItem" Content="طيران فردي" Tag="Solo"/><ComboBoxItem x:Name="PicItem" Content="PIC" Tag="PIC"/><ComboBoxItem x:Name="SimulatorItem" Content="محاكي" Tag="Simulator"/><ComboBoxItem x:Name="GroundItem" Content="تدريب أرضي" Tag="Ground"/></ComboBox><ComboBox x:Name="ResourceCombo" Grid.Column="2" PlaceholderText="الطائرة / المحاكي" DisplayMemberPath="Registration"/><TextBox x:Name="InstructorBox" Grid.Column="3" PlaceholderText="المدرب"/><CalendarDatePicker x:Name="DatePicker" Grid.Row="1"/><TimePicker x:Name="StartTimePicker" Grid.Row="1" Grid.Column="1"/><TimePicker x:Name="EndTimePicker" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="RouteBox" Grid.Row="1" Grid.Column="3" PlaceholderText="المسار / عنوان الدرس"/><TextBox x:Name="HobbsStartBox" Grid.Row="2" PlaceholderText="Hobbs بداية"/><TextBox x:Name="HobbsEndBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Hobbs نهاية"/><NumberBox x:Name="LandingsBox" Grid.Row="2" Grid.Column="2" Header="عدد الهبوط" Minimum="0" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact"/><TextBox x:Name="RemarksBox" Grid.Row="2" Grid.Column="3" PlaceholderText="ملاحظات (اختياري)"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HintText" Text="يحفظ السجل كدليل تشغيلي ويحدّث ساعات Hobbs للطائرة المسجلة." Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8"><TextBlock x:Name="SaveText" Text="حفظ السجل" FontWeight="Bold"/></Button></Grid></StackPanel></Border>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC3545" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
        <ListView x:Name="RecordsList" Grid.Row="3" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:FlightRecord"><Border Padding="14" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StudentBiDiName}" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind ActivityTypeText}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{x:Bind ResourceName}" VerticalAlignment="Center"/><StackPanel Grid.Column="3"><TextBlock Text="{x:Bind TimeText}"/><TextBlock Text="{x:Bind Route}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock Text="{x:Bind DurationText}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Landings}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
</Page>
