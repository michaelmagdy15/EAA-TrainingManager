<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EAATrainingManager.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EAATrainingManager.Models"
    mc:Ignorable="d"
    Loaded="Page_Loaded">
    <Grid Padding="22" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="PageTitle" Text="سجل التدقيق" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="PageSubtitle" Text="سجل غير قابل للتعديل للعمليات والاعتمادات" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="FromDatePicker" Width="160" />
                    <CalendarDatePicker x:Name="ToDatePicker" Width="160" />
                    <TextBox x:Name="ActorFilter" Width="155" PlaceholderText="المستخدم" />
                    <TextBox x:Name="EntityFilter" Width="155" PlaceholderText="نوع السجل" />
                    <TextBox x:Name="EntityIdFilter" Width="110" PlaceholderText="رقم السجل" />
                    <ComboBox x:Name="ActionFilter" Width="155" />
                    <Button x:Name="ApplyFiltersButton" Click="ApplyFilters_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="ExportButton" Click="Export_Click" />
                </StackPanel>
                <TextBlock x:Name="FilterStatus" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ListView x:Name="AuditList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AuditEvent">
                    <Border Padding="10,8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind OccurredAt}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Actor}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Action}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind EntityType}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="ResultCount" Grid.Row="3" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
