<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="EAATrainingManager.Views.AssessmentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EAATrainingManager.Models">
  <Grid Padding="24,16,24,24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4"><TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="DescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <Border Grid.Row="1" Padding="14" Style="{StaticResource FluentCardBorder}"><StackPanel Spacing="9"><TextBlock x:Name="AddTitleText" FontWeight="SemiBold"/><Grid ColumnSpacing="10" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="StudentCombo" DisplayMemberPath="DisplayName"/><TextBox x:Name="TitleBox" Grid.Column="1"/><TextBox x:Name="ExaminerBox" Grid.Column="2"/><ComboBox x:Name="ResultCombo" Grid.Column="3" SelectedIndex="0"><ComboBoxItem Tag="Pending" x:Name="PendingItem"/><ComboBoxItem Tag="Passed" x:Name="PassedItem"/><ComboBoxItem Tag="Conditional" x:Name="ConditionalItem"/><ComboBoxItem Tag="Failed" x:Name="FailedItem"/></ComboBox><TextBox x:Name="DeficienciesBox" Grid.Row="1" Grid.ColumnSpan="2"/><TextBox x:Name="RemedialBox" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="NextActionBox" Grid.Row="1" Grid.Column="3"/></Grid><Button x:Name="SaveButton" Click="Save_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Border>
    <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC3545" Visibility="Collapsed"/>
    <ListView x:Name="List" Grid.Row="3" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:TrainingAssessment"><Border Padding="14" Margin="0,0,0,8" Style="{StaticResource FluentCardBorder}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StudentDisplayName}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Title}"/><TextBlock Text="{x:Bind ExaminerName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind ResultText}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind NextAction}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  </Grid>
</Page>
